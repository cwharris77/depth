# Copy to .env.local and fill in. .env.local is gitignored — never commit real secrets.

# Supabase project URL — safe to commit, included here as the real default for this project.
SUPABASE_URL=https://jiqoaqmzmvtovimnmbzl.supabase.co

# Publishable key (sb_publishable_..., Supabase's replacement for the legacy anon key)
# — safe to commit, used by the app's DB RosterSource at request time.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_JPsqvaeJbAGnX1JzkUGBqA_riP7wR9u

# Browser-side Supabase client for auth (lib/supabase/client.ts, @supabase/ssr). Same
# public-safe URL + publishable key as above, but must be NEXT_PUBLIC_-prefixed to reach
# the client bundle. Safe to commit — these are the publishable values.
NEXT_PUBLIC_SUPABASE_URL=https://jiqoaqmzmvtovimnmbzl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_JPsqvaeJbAGnX1JzkUGBqA_riP7wR9u

# Secret key (sb_secret_..., Supabase's replacement for the legacy service_role key) —
# SECRET, never commit. Only needed to run the ingest/backfill scripts (bypasses RLS for
# writes). Get it from the Supabase dashboard (Settings -> API Keys -> Publishable and
# secret API keys) and put the real value in your local .env.local only.
SUPABASE_SECRET_KEY=

# --- Feature flags (Vercel Flags SDK — lib/flags.ts) ---

# SECRET. Verifies Vercel Toolbar flag overrides + the discovery endpoint
# (app/.well-known/vercel/flags). Generate per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Also set it in Vercel env (Preview/Production, mark Sensitive).
FLAGS_SECRET=

# Launch gates read by decide() in lib/flags.ts. Unset/anything-but-1 = off.
# SHOW_UNIFORM_PICKER=1 exposes the Phase 7 uniform picker (header jersey button).
SHOW_UNIFORM_PICKER=
