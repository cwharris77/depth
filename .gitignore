# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
/.worktrees/
/.cache/matchup-forecast/
.env*.local
__pycache__/

# iOS / Xcode
ios/**/xcuserdata/
*.xcuserstate
ios/DerivedData/
ios/.derivedData/
ios/.pr-screenshots/
ios/.pr-screenshots.xcresult
ios/.local-service-role-key
ios/vendor/bundle/
# frameit raw captures + framed output are release artifacts, never source (same
# rationale as ios/.pr-screenshots/ above) — but background.png IS committed, it's the
# reusable frame background, not a per-run output.
ios/fastlane/screenshots/en-US/
ios/fastlane/screenshots/*.ttf
# App Store screenshot captures are release artifacts, never source (docs/ios-appstore-screenshots.md)
/Screenshots/

ios/fastlane/README.md
ios/fastlane/report.xml


# Claude
.claude/settings.local.json