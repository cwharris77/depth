# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/web/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/web/coverage

# next.js
/web/.next/
/web/out/

# production
/web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
/.worktrees/
/web/.cache/matchup-forecast/
.env*.local
__pycache__/

# iOS / Xcode
**/xcuserdata/
*.xcuserstate
/DerivedData/
/.derivedData/
/.local-service-role-key
/vendor/bundle/
# frameit raw captures + framed output are release artifacts, never source — but
# background.png IS committed, it's the reusable frame background, not a per-run output.
/fastlane/screenshots/en-US/
/fastlane/screenshots/*.ttf
# App Store screenshot captures are release artifacts, never source (docs/ios-appstore-screenshots.md)
/Screenshots/

/fastlane/README.md
/fastlane/report.xml


# Claude
.claude/settings.local.json

# Local workflow docs
# Documentation lives in the obsidian vault (../obsidian/Projects/depth), not this repo.
/docs/
/.impeccable/
/.superpowers/
/skill-observations/
/skill-updates/