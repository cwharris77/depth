IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = 63JZBB528Q

// Release identity defaults. Debug/Staging override these three values so their apps
// install beside TestFlight instead of replacing it, while sharing the same target.
APP_BUNDLE_IDENTIFIER = com.cwharris.depth
APP_DISPLAY_NAME = The Sticks
APP_ICON_NAME = AppIcon

// DEP-425 forced-update gate: the numeric App Store id the blocking update screen deep
// links to (App Store Connect → App Information → General Information → "Apple ID").
// `0` means "not configured" — BlockingUpdateView hides its Update button rather than
// shipping a link that opens nothing.
//
// Setting this does NOT arm the gate; it only makes the Update button reachable when the
// gate is armed. Arming is a separate, deliberate migration (docs/forced-update-gate.md),
// and is unsafe until the App Store listing is public — the deep link 404s for users
// while the app is still in review.
APP_STORE_ID = 6802480325
