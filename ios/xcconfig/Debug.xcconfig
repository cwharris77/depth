#include "Base.xcconfig"

APP_BUNDLE_IDENTIFIER = com.cwharris.depth.dev
APP_DISPLAY_NAME = The Sticks Dev
APP_ICON_NAME = AppIconDev

// Points Debug builds/tests at the local Supabase CLI instance (`supabase start`,
// see docs/espn.md) instead of prod — DEP-270. PUBLISHABLE_KEY is Supabase's
// deterministic local-dev demo key: derived from config.toml's project_id "depth"
// plus the CLI's default JWT secret, so it's the same value on every machine
// running `supabase start` against this repo (confirmed stable across restarts via
// `supabase status`), not a per-developer secret.
// "/$()/" breaks up "//" so xcconfig's line-comment parser doesn't truncate the URL.
SUPABASE_URL = http:/$()/127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY = sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
